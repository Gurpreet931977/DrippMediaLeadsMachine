{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "static",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://dripp-leads-api-ukng7vge6q-uc.a.run.app/api/:path*"
    },
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/favicon.ico",
      "destination": "/logos/favicon.png"
    },
    {
      "source": "/favicon.png",
      "destination": "/logos/favicon.png"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
